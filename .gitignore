<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SAM DARSHANA ON-LINE Logo</title>
  <link href="https://googleapis.com" rel="stylesheet">
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      background-color: #ffffff;
      font-family: 'Quicksand', sans-serif;
    }

    .logo-wrapper {
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 2rem;
    }

    .brand-title {
      margin-top: 16px;
      font-size: 2.6rem;
      font-weight: 700;
      color: #590829;
      letter-spacing: 3px;
      text-transform: uppercase;
    }

    .brand-subtitle {
      margin-top: 6px;
      font-size: 1.35rem;
      font-weight: 600;
      color: #e61e6e;
      letter-spacing: 8px;
      text-transform: uppercase;
    }
  </style>
</head>
<body>

  <div class="logo-wrapper">
    <!-- Vector Icon: S with Signal Waves -->
    <svg width="280" height="140" viewBox="0 0 280 140" xmlns="http://w3.org">
      <defs>
        <!-- Diagonal Split Clip for Two-Tone 'S' -->
        <clipPath id="top-half">
          <polygon points="80,0 200,0 200,45 80,105" />
        </clipPath>
        <clipPath id="bottom-half">
          <polygon points="80,105 200,45 200,140 80,140" />
        </clipPath>

        <!-- Bold Geometric 'S' Shape -->
        <path id="s-shape" d="
          M 178 14 
          H 128 
          C 106 14, 94 26, 94 44 
          C 94 62, 106 72, 128 72 
          H 148 
          C 155 72, 159 76, 159 83 
          C 159 90, 155 94, 148 94 
          H 98 
          V 124 
          H 148 
          C 172 124, 186 111, 186 90 
          C 186 71, 173 60, 150 60 
          H 131 
          C 124 60, 120 56, 120 50 
          C 120 44, 124 40, 131 40 
          H 178 
          Z" />
      </defs>

      <!-- Left Signal Waves (Magenta) -->
      <g fill="none" stroke="#e61e6e" stroke-linecap="round">
        <circle cx="80" cy="70" r="4" fill="#e61e6e" stroke="none" />
        <path d="M 68 57 A 18 18 0 0 0 68 83" stroke-width="5.5" />
        <path d="M 55 46 A 33 33 0 0 0 55 94" stroke-width="5.5" />
        <path d="M 42 35 A 48 48 0 0 0 42 105" stroke-width="5.5" />
      </g>

      <!-- Center Two-Tone 'S' -->
      <use href="#s-shape" fill="#e61e6e" clip-path="url(#top-half)" />
      <use href="#s-shape" fill="#590829" clip-path="url(#bottom-half)" />

      <!-- Right Signal Waves (Maroon) -->
      <g fill="none" stroke="#590829" stroke-linecap="round">
        <circle cx="200" cy="70" r="4" fill="#590829" stroke="none" />
        <path d="M 212 57 A 18 18 0 0 1 212 83" stroke-width="5.5" />
        <path d="M 225 46 A 33 33 0 0 1 225 94" stroke-width="5.5" />
        <path d="M 238 35 A 48 48 0 0 1 238 105" stroke-width="5.5" />
      </g>
    </svg>

    <!-- Brand Typography -->
    <div class="brand-title">SAM DARSHANA</div>
    <div class="brand-subtitle">ON-LINE</div>
  </div>

</body>
</html>

/bootstrap/data
/bootstrap/tmp
/classes/
/dist/
/exploded-archives/
/test-build/
/test-output/
/test-report/
/target/
temp-testng-customsuite.xml

# based on http://stackoverflow.com/a/8865858/422476 I am removing inline comments

#/classes/  		              all class files
#/dist/                       contains generated war files for deployment
#/exploded-archives/		      war content generation during deploy (or explode)
#/test-build/                 test compilation (ant target for Seam)
#/test-output/                test results
#/test-report/                test report generation for, e.g., Hudson
#/target/                     maven output folder
#temp-testng-customsuite.xml	generated when running test cases under Eclipse

